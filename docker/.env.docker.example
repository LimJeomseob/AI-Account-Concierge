# 앱 스택 환경변수 — docker/.env 로 복사해서 채운다.
#   cp docker/.env.docker.example docker/.env
# 「로컬」과 「서버」 값을 병기했다. 해당 줄만 남기고 나머지는 지운다.
# ─────────────────────────────────────────────────────────────────

# ── 1. 주소 ────────────────────────────────────────────────────
# 로컬
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# 서버 (DOMAIN=gnu-ai.kr 이면)
# NEXT_PUBLIC_APP_URL=https://app.gnu-ai.kr
# NEXT_PUBLIC_SUPABASE_URL=https://api.gnu-ai.kr
# DOMAIN=gnu-ai.kr

# 앱 컨테이너 → Supabase 내부망 주소. 바꾸지 않는다.
SUPABASE_URL=http://kong:8000
# Supabase 스택 네트워크 이름. supabase-project 디렉터리에서 띄웠다면 기본값 그대로.
SUPABASE_NETWORK=supabase-project_default
# 앱을 호스트에 노출할 포트 (서버에서는 Caddy 가 앞에 서므로 3000 유지)
APP_PORT=3000

# ── 2. Supabase 키 (supabase-project 에서 `sh run.sh secrets` 로 확인) ──
# 이름이 다르니 주의: Supabase 쪽 SUPABASE_SECRET_KEY  → 여기 SUPABASE_SERVICE_ROLE_KEY
#                    Supabase 쪽 SUPABASE_PUBLISHABLE_KEY → 여기 NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 3. 비밀 값 (한 번 만들면 바꾸지 않는다) ─────────────────
# openssl rand -base64 32   ← VAULT_KEY (잃어버리면 계정 금고 복호화 불가)
VAULT_KEY=
# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 32
CRON_SECRET=

# ── 4. 메일 ──────────────────────────────────────────────────
# 비워 두면 발송하지 않고 대기열에만 쌓인다(로컬 시험용).
RESEND_API_KEY=

# ── 5. 최초 관리자 (시드 스크립트가 사용) ───────────────────
INITIAL_ADMIN_EMAIL=admin@gnu.ac.kr
