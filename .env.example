# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (서울 리전 ap-northeast-2)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# 메일 — Gmail SMTP (발신 계정 + 앱 비밀번호). 둘 중 하나라도 비면 발송하지 않고 대기열에만 쌓인다.
# 앱 비밀번호: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호(16자리). From 주소는 GMAIL_USER 로 고정된다.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# 비밀 값
# APP_SECRET: 링크 서명(HMAC) 키 — `openssl rand -hex 32`
APP_SECRET=
# CRON_SECRET: Vercel Cron 인증 — `openssl rand -hex 32`
CRON_SECRET=

# 최초 관리자 — admins 표가 비어 있을 때 이 Google 계정으로 처음 로그인하면 자동 등록된다
# (scripts/seed.ts 도 같은 값을 쓴다). 관리자가 1명 이상이면 무시되며 이후 추가는 설정 화면에서.
INITIAL_ADMIN_EMAIL=admin@gnu.ac.kr

# DB 직접 접속 (마이그레이션 psql 용, 앱 실행에는 쓰이지 않음) — Supabase > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
