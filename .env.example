# Vercel 환경변수 목록 (Vercel > Settings > Environment Variables 에 등록, Production·Preview 모두)
# 로컬 실행은 하지 않는다(2026-10-29) — 이 파일은 등록할 이름과 형식의 예시일 뿐이다.
# 접속 주소는 https://ai-account-concierge.vercel.app 로 코드에 고정돼 있다(lib/site.ts). NEXT_PUBLIC_APP_URL 은 쓰지 않는다.

# Supabase (서울 리전 ap-northeast-2) — Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# 메일 — Gmail SMTP (발신 계정 + 앱 비밀번호). 둘 중 하나라도 비면 발송하지 않고 대기열에만 쌓인다.
# 앱 비밀번호: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호(16자리). From 주소는 GMAIL_USER 로 고정된다.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# 비밀 값 — `openssl rand -hex 32` 로 만든다
# APP_SECRET: 장애 신고 링크 서명(HMAC) 키
APP_SECRET=
# CRON_SECRET: Vercel Cron 인증 — 없으면 매일·매월 자동 작업이 실행되지 않는다(필수)
CRON_SECRET=

# 최초 관리자(선택) — admins 표가 비어 있을 때 이 Google 계정으로 처음 로그인하면 자동 등록된다.
# 관리자가 1명 이상이면 무시되며 이후 추가는 설정 > 로그인 허용 관리자에서.
INITIAL_ADMIN_EMAIL=admin@gnu.ac.kr
